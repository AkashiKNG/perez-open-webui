# Chave da NVIDIA NIM (https://build.nvidia.com/settings/api-keys). Sem ela, só os modelos grátis do gpt4free.
NVIDIA_NIM_API_KEY=

# Cadastro aberto. Deixe "true" para criar a sua conta (a primeira vira administradora) e troque
# para "false" depois, para ninguém mais se cadastrar.
OPEN_WEBUI_ENABLE_SIGNUP=true
